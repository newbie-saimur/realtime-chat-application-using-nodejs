// =============================================================================
// UNIVERSAL BACKTEST FRAMEWORK v2.0 — Pine Script v5
// Crypto (BTCUSDT · ETHUSDT) | Forex (EURUSD · GBPUSD · USDJPY) | Gold (XAUUSD)
// Bar-Replay compatible | No repainting | Partial TP | Break-Even | HTF
//
// ── Commission guide (edit commission_value in strategy() below) ──────────────
//   Crypto spot / futures  →  0.05 % (Binance) | 0.04 % (Bybit maker)
//   Forex majors           →  0.003 % (≈ 0.3-pip spread proxy)
//   Gold XAUUSD            →  0.01  % (≈ $0.20 spread at $2 000/oz)
//
// ── Slippage guide (edit slippage below) ─────────────────────────────────────
//   M1 / M5 → 3–5 ticks | M15 / H1 → 2–3 ticks | H4 / D → 1–2 ticks
// =============================================================================
//@version=5
strategy(
     title                   = "Universal Backtest Framework v2.0",
     shorttitle               = "UBF v2.0",
     overlay                  = true,
     pyramiding               = 0,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 10,
     initial_capital          = 10000,
     currency                 = currency.USD,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.05,   // ← change per asset class (see header)
     slippage                 = 2,
     calc_on_every_tick       = false,
     process_orders_on_close  = false   // orders fill at next bar open — no repainting
 )

// =============================================================================
// ─── INPUTS ──────────────────────────────────────────────────────────────────
// =============================================================================

// ── Date Range ────────────────────────────────────────────────────────────────
var GRP_DATE  = "Date Range"
i_date_mode   = input.string("Last 1 Year", "Backtest Period",
     options  = ["Last 6 Months","Last 1 Year","Last 2 Years","Last 3 Years","Custom"],
     tooltip  = "Bar Replay: set TradingView's replay cursor inside this window.",
     group    = GRP_DATE)
i_cust_start  = input.time(timestamp("2023-01-01 00:00"), "Custom Start", group=GRP_DATE)
i_cust_end    = input.time(timestamp("2099-12-31 23:59"), "Custom End",   group=GRP_DATE)

// Compute window from wall-clock (timenow) — updated every bar, always current
_DAY = 86_400_000
date_from = switch i_date_mode
    "Last 6 Months" => timenow - 183  * _DAY
    "Last 1 Year"   => timenow - 365  * _DAY
    "Last 2 Years"  => timenow - 730  * _DAY
    "Last 3 Years"  => timenow - 1095 * _DAY
    "Custom"        => int(i_cust_start)
    =>                 timenow - 365  * _DAY
date_to   = i_date_mode == "Custom" ? int(i_cust_end) : int(timenow)
in_range  = time >= date_from and time <= date_to

// ── Trend — EMA ───────────────────────────────────────────────────────────────
var GRP_EMA   = "Trend — EMA"
i_ema_fast    = input.int(20, "EMA Fast", minval=1, group=GRP_EMA)
i_ema_slow    = input.int(50, "EMA Slow", minval=1, group=GRP_EMA)

// ── Momentum — RSI ────────────────────────────────────────────────────────────
var GRP_RSI   = "Momentum — RSI"
i_rsi_len     = input.int(14, "RSI Length",     minval=1,  group=GRP_RSI)
i_rsi_long    = input.int(50, "Long min RSI",   minval=1, maxval=99, group=GRP_RSI)
i_rsi_short   = input.int(50, "Short max RSI",  minval=1, maxval=99, group=GRP_RSI)

// ── Optional Filters ──────────────────────────────────────────────────────────
var GRP_FILT  = "Optional Filters"
i_use_vwap    = input.bool(false, "VWAP Filter",               group=GRP_FILT)
i_use_vol     = input.bool(false, "Volume Filter",             group=GRP_FILT)
i_vol_mult    = input.float(1.5,  "Volume Multiplier", step=0.1, group=GRP_FILT)
i_use_adx     = input.bool(true,  "ADX Trending Filter",       group=GRP_FILT)
i_adx_thresh  = input.int(20,     "ADX Threshold",  minval=5,  group=GRP_FILT)
i_trend_only  = input.bool(true,  "Trend-Only Mode (EMA slope)", group=GRP_FILT)

// ── Support / Resistance Breakout ─────────────────────────────────────────────
var GRP_SR    = "Support / Resistance Breakout"
i_sr_bars     = input.int(20, "Lookback Bars", minval=3, maxval=500, group=GRP_SR)

// ── Higher-Timeframe Confirmation ─────────────────────────────────────────────
var GRP_MTF   = "Higher-Timeframe Confirmation"
i_use_htf     = input.bool(false,  "Enable HTF Confirmation", group=GRP_MTF)
i_htf         = input.timeframe("60", "HTF",                  group=GRP_MTF)

// ── Stop Loss ─────────────────────────────────────────────────────────────────
var GRP_SL    = "Stop Loss"
i_sl_mode     = input.string("ATR", "SL Mode", options=["ATR","Fixed","Percent"], group=GRP_SL)
i_atr_len     = input.int(14,   "ATR Length",           minval=1,   group=GRP_SL)
i_atr_mult    = input.float(1.5,"ATR Multiplier",       step=0.1,   group=GRP_SL)
i_fixed_sl    = input.float(50, "Fixed SL (points)",    step=0.5,   group=GRP_SL)
i_pct_sl      = input.float(1.0,"Percent SL (%)",       step=0.1,   group=GRP_SL)

// ── Take Profit & Exits ───────────────────────────────────────────────────────
var GRP_TP    = "Take Profit & Exits"
i_rr          = input.float(2.0, "Risk/Reward Ratio",       step=0.1, minval=0.1, group=GRP_TP)
i_use_trail   = input.bool(false,"Trailing Stop",                               group=GRP_TP)
i_trail_pts   = input.float(30,  "Trail Offset (points)",   step=0.5,           group=GRP_TP)
i_use_be      = input.bool(false,"Break-Even Stop",                             group=GRP_TP)
i_be_r        = input.float(1.0, "Break-Even Trigger (R)",  step=0.1,           group=GRP_TP)
i_use_partial = input.bool(false,"Partial Take Profit",                         group=GRP_TP)
i_partial_pct = input.float(50,  "Partial TP — close %",    step=5, minval=1, maxval=99, group=GRP_TP)
i_partial_r   = input.float(1.0, "Partial TP at (R)",       step=0.1,           group=GRP_TP)

// ── Position Sizing ───────────────────────────────────────────────────────────
var GRP_SIZE  = "Position Sizing"
i_size_mode   = input.string("RiskPct","Method", options=["RiskPct","FixedLot"], group=GRP_SIZE)
i_risk_pct    = input.float(1.0,"Risk % per Trade", step=0.1, minval=0.01,       group=GRP_SIZE,
     tooltip   = "Percentage of current equity risked per trade.")
i_fixed_lot   = input.float(1.0,"Fixed Lot Size",   step=0.001, minval=0.001,    group=GRP_SIZE)
i_leverage    = input.float(1.0,"Leverage",          step=1,   minval=1,          group=GRP_SIZE,
     tooltip   = "Multiplies position size. Amplifies both profit and loss.")

// ── Loss Protection ───────────────────────────────────────────────────────────
var GRP_DD    = "Loss Protection"
i_max_dd_pct  = input.float(5.0,"Max Daily Drawdown (%)",   step=0.5, group=GRP_DD)
i_max_consec  = input.int(3,    "Max Consecutive Losses",   minval=1, group=GRP_DD)
i_cooldown    = input.int(5,    "Cooldown Bars After Loss",  minval=0, group=GRP_DD)

// ── Session Filter ────────────────────────────────────────────────────────────
var GRP_SESS  = "Session Filter"
i_use_sess    = input.bool(false, "Enable Session Filter",          group=GRP_SESS)
i_session     = input.session("0800-1700","Session (Exchange TZ)", group=GRP_SESS)

// ── Visualization ─────────────────────────────────────────────────────────────
var GRP_VIS   = "Visualization"
i_show_table  = input.bool(true, "Show Dashboard",       group=GRP_VIS)
i_color_bars  = input.bool(true, "Color Bars by Trend",  group=GRP_VIS)
i_show_levels = input.bool(true, "Show SL / TP Lines",   group=GRP_VIS)

// =============================================================================
// ─── INDICATORS ──────────────────────────────────────────────────────────────
// =============================================================================

ema_fast  = ta.ema(close, i_ema_fast)
ema_slow  = ta.ema(close, i_ema_slow)
rsi_val   = ta.rsi(close, i_rsi_len)
atr_val   = ta.atr(i_atr_len)
vwap_val  = ta.vwap(hlc3)
vol_sma   = ta.sma(volume, 20)
[_, _, adx_val] = ta.dmi(14, 14)

// [1] offset: previous bar's high/low excludes the current candle — no repainting
res = ta.highest(high, i_sr_bars)[1]
sup = ta.lowest(low,  i_sr_bars)[1]

// lookahead_off: HTF value is the confirmed close of the last completed HTF bar
htf_fast = request.security(syminfo.tickerid, i_htf, ta.ema(close, i_ema_fast), lookahead=barmerge.lookahead_off)
htf_slow = request.security(syminfo.tickerid, i_htf, ta.ema(close, i_ema_slow), lookahead=barmerge.lookahead_off)

// =============================================================================
// ─── HELPER FUNCTIONS ────────────────────────────────────────────────────────
// =============================================================================

// SL distance in price units (absolute, always positive)
f_sl_dist() =>
    switch i_sl_mode
        "ATR"     => atr_val * i_atr_mult
        "Fixed"   => i_fixed_sl * syminfo.mintick
        "Percent" => close * i_pct_sl / 100
        =>           atr_val * i_atr_mult

// Position size in contracts/units
// Leverage multiplies position size: larger size, same margin requirement
f_qty(sl_dist) =>
    pv = math.max(syminfo.pointvalue, 1e-10)   // guard against 0 on some brokers
    switch i_size_mode
        "RiskPct"  => strategy.equity * (i_risk_pct / 100) * i_leverage / math.max(sl_dist * pv, 1e-10)
        "FixedLot" => i_fixed_lot
        =>            i_fixed_lot

f_in_session() => not i_use_sess or not na(time(timeframe.period, i_session))

// =============================================================================
// ─── LOSS PROTECTION STATE ───────────────────────────────────────────────────
// =============================================================================

var int   consec_loss   = 0
var int   cooldown_bar  = 0
var float day_open_eq   = strategy.equity

// Reset daily equity baseline at the first bar of each new day
is_new_day = ta.change(dayofweek) != 0
if is_new_day
    day_open_eq := strategy.equity

daily_dd_pct = (day_open_eq - strategy.equity) / math.max(day_open_eq, 1.0) * 100
trade_gate   = daily_dd_pct < i_max_dd_pct and cooldown_bar == 0 and consec_loss < i_max_consec

if cooldown_bar > 0
    cooldown_bar -= 1

// =============================================================================
// ─── RUNNING PERFORMANCE STATISTICS ─────────────────────────────────────────
// Updated once per closed trade — O(1) per bar, no end-of-data loops
// =============================================================================

var int   st_wins     = 0
var int   st_losses   = 0
var float st_gprofit  = 0.0   // gross profit ($)
var float st_gloss    = 0.0   // gross loss   ($, positive)
var int   st_cw       = 0     // current consecutive wins
var int   st_cl       = 0     // current consecutive losses
var int   st_max_cw   = 0     // all-time max consecutive wins
var int   st_max_cl   = 0     // all-time max consecutive losses

new_close = strategy.closedtrades > strategy.closedtrades[1]
if new_close
    idx       = strategy.closedtrades - 1
    trade_pnl = strategy.closedtrades.profit(idx)
    if trade_pnl > 0
        st_wins    += 1
        st_gprofit += trade_pnl
        st_cw      += 1
        st_cl       := 0
        st_max_cw   := math.max(st_max_cw, st_cw)
        consec_loss := 0
        cooldown_bar := 0
    else
        st_losses  += 1
        st_gloss   += math.abs(trade_pnl)
        st_cl      += 1
        st_cw       := 0
        st_max_cl   := math.max(st_max_cl, st_cl)
        consec_loss := st_cl
        cooldown_bar := i_cooldown

// =============================================================================
// ─── SIGNAL CONDITIONS ───────────────────────────────────────────────────────
// =============================================================================

bull       = ema_fast > ema_slow
bear       = ema_fast < ema_slow
slope_bull = ema_slow > ema_slow[5]   // EMA is sloping up over 5 bars
slope_bear = ema_slow < ema_slow[5]

rsi_bull   = rsi_val > i_rsi_long
rsi_bear   = rsi_val < i_rsi_short
vwap_l     = not i_use_vwap or close > vwap_val
vwap_s     = not i_use_vwap or close < vwap_val
vol_ok     = not i_use_vol  or volume > vol_sma * i_vol_mult
adx_ok     = not i_use_adx  or adx_val > i_adx_thresh
htf_l      = not i_use_htf  or htf_fast > htf_slow
htf_s      = not i_use_htf  or htf_fast < htf_slow
trend_l    = not i_trend_only or slope_bull
trend_s    = not i_trend_only or slope_bear

// Breakout: close breaks beyond previous swing high/low (no repainting — [1] applied above)
bo_long    = close > res
bo_short   = close < sup

sess_ok    = f_in_session()
flat       = strategy.position_size == 0

long_sig   = bull and rsi_bull and bo_long  and vwap_l and vol_ok and adx_ok and htf_l and trend_l and sess_ok and in_range and trade_gate and flat
short_sig  = bear and rsi_bear and bo_short and vwap_s and vol_ok and adx_ok and htf_s and trend_s and sess_ok and in_range and trade_gate and flat

// =============================================================================
// ─── TRADE STATE ─────────────────────────────────────────────────────────────
// =============================================================================

var float ep          = na   // entry price
var float sl          = na   // active SL price
var float tp          = na   // full TP price
var float ptp         = na   // partial TP price
var float sl_dist0    = na   // SL distance at entry (for BE trigger calculation)
var bool  be_done_l   = false
var bool  be_done_s   = false

// Wipe trade state when position is flat
if flat
    ep       := na
    sl       := na
    tp       := na
    ptp      := na
    sl_dist0 := na
    be_done_l := false
    be_done_s := false

// =============================================================================
// ─── ENTRIES ─────────────────────────────────────────────────────────────────
// =============================================================================

if long_sig
    sd        = f_sl_dist()
    ep       := close
    sl       := close - sd
    tp       := close + sd * i_rr
    ptp      := close + sd * i_partial_r
    sl_dist0 := sd
    strategy.entry("Long", strategy.long, qty=f_qty(sd))

    if i_use_partial
        // qty_percent=i_partial_pct closes that share of the position at ptp
        // qty_percent=100 on "Long.Full" closes whatever remains after partial fires
        strategy.exit("Long.P",    "Long", qty_percent=i_partial_pct,       limit=ptp, stop=sl)
        strategy.exit("Long.Full", "Long", qty_percent=100,                 limit=tp,  stop=sl)
    else if i_use_trail
        strategy.exit("Long.T",    "Long", trail_price=ep, trail_offset=i_trail_pts * syminfo.mintick, stop=sl)
    else
        strategy.exit("Long.X",    "Long", limit=tp, stop=sl)

if short_sig
    sd        = f_sl_dist()
    ep       := close
    sl       := close + sd
    tp       := close - sd * i_rr
    ptp      := close - sd * i_partial_r
    sl_dist0 := sd
    strategy.entry("Short", strategy.short, qty=f_qty(sd))

    if i_use_partial
        strategy.exit("Short.P",    "Short", qty_percent=i_partial_pct,     limit=ptp, stop=sl)
        strategy.exit("Short.Full", "Short", qty_percent=100,               limit=tp,  stop=sl)
    else if i_use_trail
        strategy.exit("Short.T",    "Short", trail_price=ep, trail_offset=i_trail_pts * syminfo.mintick, stop=sl)
    else
        strategy.exit("Short.X",    "Short", limit=tp, stop=sl)

// =============================================================================
// ─── BREAK-EVEN STOP ─────────────────────────────────────────────────────────
// Re-calling strategy.exit() with the same ID updates the existing order in place.
// =============================================================================

if i_use_be and not na(ep) and not na(sl_dist0)
    if strategy.position_size > 0 and not be_done_l
        if high >= ep + sl_dist0 * i_be_r
            be_done_l := true
            sl        := ep
            if i_use_partial
                strategy.exit("Long.P",    "Long", qty_percent=i_partial_pct, limit=ptp, stop=sl)
                strategy.exit("Long.Full", "Long", qty_percent=100,           limit=tp,  stop=sl)
            else
                strategy.exit("Long.X",    "Long", limit=tp, stop=sl)

    else if strategy.position_size < 0 and not be_done_s
        if low <= ep - sl_dist0 * i_be_r
            be_done_s := true
            sl        := ep
            if i_use_partial
                strategy.exit("Short.P",    "Short", qty_percent=i_partial_pct, limit=ptp, stop=sl)
                strategy.exit("Short.Full", "Short", qty_percent=100,           limit=tp,  stop=sl)
            else
                strategy.exit("Short.X",    "Short", limit=tp, stop=sl)

// =============================================================================
// ─── VISUALIZATION ───────────────────────────────────────────────────────────
// =============================================================================

// Core indicator plots
plot(ema_fast,              "EMA Fast",   color=color.new(color.blue,   0), linewidth=2)
plot(ema_slow,              "EMA Slow",   color=color.new(color.orange, 0), linewidth=2)
plot(i_use_vwap ? vwap_val : na, "VWAP", color=color.new(color.purple, 40), linewidth=1)

// S/R levels (stepline so gaps are visible when level changes)
plot(res, "Resistance", color=color.new(color.red,  60), style=plot.style_stepline, linewidth=1)
plot(sup, "Support",    color=color.new(color.lime, 60), style=plot.style_stepline, linewidth=1)

// Active trade price levels
plot(i_show_levels and not na(sl)  ? sl  : na, "SL",         color=color.new(color.red,    0), style=plot.style_linebr, linewidth=1)
plot(i_show_levels and not na(tp)  ? tp  : na, "TP",         color=color.new(color.green,  0), style=plot.style_linebr, linewidth=1)
plot(i_show_levels and not na(ep)  ? ep  : na, "Entry",      color=color.new(color.white,  0), style=plot.style_linebr, linewidth=1)
plot(i_show_levels and i_use_partial and not na(ptp) ? ptp : na, "Partial TP",
     color=color.new(color.teal, 0), style=plot.style_linebr, linewidth=1)

// Bar coloring by trend direction
barcolor(i_color_bars ? (bull ? color.new(color.teal, 70) : color.new(color.maroon, 70)) : na)

// Shade bars outside the backtest window so the active range is obvious
bgcolor(not in_range ? color.new(color.gray, 90) : na, title="Out of Range")

// Entry signals
plotshape(long_sig,  "Long Signal",  shape.triangleup,   location.belowbar, color.lime, size=size.small, text="L")
plotshape(short_sig, "Short Signal", shape.triangledown, location.abovebar, color.red,  size=size.small, text="S")

// Active trade floating label — only on confirmed bars to avoid repainting on the live bar
if not na(ep) and barstate.isconfirmed
    dir   = strategy.position_size > 0 ? "▲ LONG" : "▼ SHORT"
    upnl  = strategy.openprofit
    lc    = upnl >= 0 ? color.new(color.green, 20) : color.new(color.red, 20)
    label.new(bar_index, high,
         dir + "  PnL: $" + str.tostring(math.round(upnl, 2)),
         color=lc, textcolor=color.white, style=label.style_label_down, size=size.tiny)

// =============================================================================
// ─── PERFORMANCE DASHBOARD ───────────────────────────────────────────────────
// =============================================================================

total_t    = st_wins + st_losses
win_rate   = total_t > 0 ? st_wins   / total_t * 100   : 0.0
pf         = st_gloss  > 0 ? st_gprofit / st_gloss     : 0.0
avg_win    = st_wins   > 0 ? st_gprofit / st_wins       : 0.0
avg_loss   = st_losses > 0 ? st_gloss   / st_losses     : 0.0
// Expectancy: expected dollar return per trade
expectancy = total_t > 0 ? (win_rate / 100 * avg_win) - ((1.0 - win_rate / 100) * avg_loss) : 0.0
// Avg RR achieved (ratio of average winner to average loser in dollars)
rr_actual  = avg_loss > 0 ? avg_win / avg_loss : 0.0
// Recovery factor: net profit relative to max drawdown
rec_factor = strategy.max_drawdown > 0 ? strategy.netprofit / strategy.max_drawdown : 0.0

var table dash = table.new(position.top_right, 2, 16,
     border_width=1, border_color=color.new(color.gray, 55),
     bgcolor=color.new(color.black, 15))

if i_show_table and barstate.islast
    H   = color.new(color.navy,  0)
    LBL = color.new(color.black, 45)
    G   = color.new(color.green, 25)
    R   = color.new(color.red,   25)
    N   = color.new(color.gray,  30)
    W   = color.white
    SZ  = size.small

    // header
    table.cell(dash, 0, 0, "METRIC",          text_color=W, bgcolor=H,   text_size=SZ)
    table.cell(dash, 1, 0, "VALUE",            text_color=W, bgcolor=H,   text_size=SZ)
    // period
    table.cell(dash, 0, 1, "Period",           text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 1, i_date_mode,        text_color=W, bgcolor=N,   text_size=SZ)
    // total trades
    table.cell(dash, 0, 2, "Total Trades",     text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 2, str.tostring(total_t), text_color=W, bgcolor=N, text_size=SZ)
    // win rate
    table.cell(dash, 0, 3, "Win Rate",         text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 3, str.tostring(math.round(win_rate, 1)) + "%",
         text_color=W, bgcolor=win_rate >= 50 ? G : R, text_size=SZ)
    // profit factor
    table.cell(dash, 0, 4, "Profit Factor",    text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 4, str.tostring(math.round(pf, 2)),
         text_color=W, bgcolor=pf >= 1.5 ? G : pf >= 1.0 ? N : R, text_size=SZ)
    // net profit
    table.cell(dash, 0, 5, "Net Profit",       text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 5, "$" + str.tostring(math.round(strategy.netprofit, 2)),
         text_color=W, bgcolor=strategy.netprofit >= 0 ? G : R, text_size=SZ)
    // max drawdown
    table.cell(dash, 0, 6, "Max Drawdown",     text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 6, "$" + str.tostring(math.round(strategy.max_drawdown, 2)),
         text_color=W, bgcolor=R, text_size=SZ)
    // recovery factor
    table.cell(dash, 0, 7, "Recovery Factor",  text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 7, str.tostring(math.round(rec_factor, 2)),
         text_color=W, bgcolor=rec_factor >= 2 ? G : rec_factor >= 1 ? N : R, text_size=SZ)
    // avg win
    table.cell(dash, 0, 8, "Avg Win",          text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 8, "$" + str.tostring(math.round(avg_win, 2)),
         text_color=W, bgcolor=G, text_size=SZ)
    // avg loss
    table.cell(dash, 0, 9, "Avg Loss",         text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 9, "$" + str.tostring(math.round(avg_loss, 2)),
         text_color=W, bgcolor=R, text_size=SZ)
    // avg RR achieved
    table.cell(dash, 0, 10, "Avg RR (actual)", text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 10, str.tostring(math.round(rr_actual, 2)),
         text_color=W, bgcolor=rr_actual >= i_rr ? G : N, text_size=SZ)
    // expectancy
    table.cell(dash, 0, 11, "Expectancy",      text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 11, "$" + str.tostring(math.round(expectancy, 2)),
         text_color=W, bgcolor=expectancy >= 0 ? G : R, text_size=SZ)
    // wins / losses
    table.cell(dash, 0, 12, "Wins / Losses",   text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 12, str.tostring(st_wins) + " / " + str.tostring(st_losses),
         text_color=W, bgcolor=N, text_size=SZ)
    // max consecutive wins
    table.cell(dash, 0, 13, "Max Consec Win",  text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 13, str.tostring(st_max_cw), text_color=W, bgcolor=G, text_size=SZ)
    // max consecutive losses
    table.cell(dash, 0, 14, "Max Consec Loss", text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 14, str.tostring(st_max_cl), text_color=W, bgcolor=R, text_size=SZ)
    // daily DD status
    table.cell(dash, 0, 15, "Daily DD Used",   text_color=W, bgcolor=LBL, text_size=SZ)
    table.cell(dash, 1, 15, str.tostring(math.round(daily_dd_pct, 2)) + "%",
         text_color=W, bgcolor=daily_dd_pct >= i_max_dd_pct ? R : N, text_size=SZ)

// =============================================================================
// ─── ALERTS ──────────────────────────────────────────────────────────────────
// Set trigger to "Once Per Bar Close" in TradingView for no-repaint delivery.
// =============================================================================

alertcondition(long_sig,  "BUY",  "UBF BUY  | {{ticker}} @ {{close}} | TF: {{interval}}")
alertcondition(short_sig, "SELL", "UBF SELL | {{ticker}} @ {{close}} | TF: {{interval}}")

_was_long  = strategy.position_size[1] > 0 and strategy.position_size == 0
_was_short = strategy.position_size[1] < 0 and strategy.position_size == 0
_last_pnl  = strategy.closedtrades > 0
     ? strategy.closedtrades.profit(strategy.closedtrades - 1) : 0.0

alertcondition(_was_long  and _last_pnl > 0, "Long TP Hit",  "UBF Long TP  | {{ticker}} @ {{close}}")
alertcondition(_was_long  and _last_pnl < 0, "Long SL Hit",  "UBF Long SL  | {{ticker}} @ {{close}}")
alertcondition(_was_short and _last_pnl > 0, "Short TP Hit", "UBF Short TP | {{ticker}} @ {{close}}")
alertcondition(_was_short and _last_pnl < 0, "Short SL Hit", "UBF Short SL | {{ticker}} @ {{close}}")

// =============================================================================
// ─── NEWS FILTER PLACEHOLDER ─────────────────────────────────────────────────
// To activate: add  i_block_news = input.bool(false, "Block Trades (News)")
// Then add `and not i_block_news` to long_sig / short_sig conditions above.
// Toggle before high-impact events: NFP, CPI, FOMC, BOE, ECB, etc.
// =============================================================================
