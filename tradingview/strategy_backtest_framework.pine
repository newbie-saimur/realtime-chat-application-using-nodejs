// =============================================================================
// UNIVERSAL BACKTESTING FRAMEWORK — Pine Script v5
// Supports: Crypto (BTCUSDT, ETHUSDT), Forex (EURUSD, GBPUSD, USDJPY), Gold (XAUUSD)
// Strategy: EMA Trend + RSI + Optional VWAP/Volume + S/R Breakout
// =============================================================================
//@version=5
strategy(
     title                = "Universal Backtest Framework v1.0",
     shorttitle           = "UBF v1.0",
     overlay              = true,
     pyramiding           = 0,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 10,
     initial_capital      = 10000,
     currency             = currency.USD,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.05,
     slippage             = 2,
     calc_on_every_tick   = false,
     process_orders_on_close = false
 )

// =============================================================================
// ─── INPUT GROUPS ────────────────────────────────────────────────────────────
// =============================================================================

// ── Trend Indicators ─────────────────────────────────────────────────────────
var string GRP_TREND = "Trend Indicators"
i_ema_fast      = input.int(20,  "EMA Fast",        minval=1,   group=GRP_TREND)
i_ema_slow      = input.int(50,  "EMA Slow",        minval=1,   group=GRP_TREND)

// ── RSI Settings ─────────────────────────────────────────────────────────────
var string GRP_RSI = "RSI Settings"
i_rsi_len       = input.int(14,  "RSI Length",      minval=1,   group=GRP_RSI)
i_rsi_long_min  = input.int(50,  "RSI Long Min",    minval=1,   maxval=99, group=GRP_RSI)
i_rsi_short_max = input.int(50,  "RSI Short Max",   minval=1,   maxval=99, group=GRP_RSI)

// ── Optional Filters ─────────────────────────────────────────────────────────
var string GRP_FILTERS = "Optional Filters"
i_use_vwap      = input.bool(false, "Use VWAP Filter",          group=GRP_FILTERS)
i_use_volume    = input.bool(false, "Use Volume Filter",         group=GRP_FILTERS)
i_vol_mult      = input.float(1.5,  "Volume Multiplier",        minval=0.1, step=0.1, group=GRP_FILTERS)
i_use_adx       = input.bool(true,  "Use ADX Trend Filter",     group=GRP_FILTERS)
i_adx_thresh    = input.int(20,     "ADX Threshold (Trending)", minval=5, maxval=100, group=GRP_FILTERS)
i_trend_only    = input.bool(true,  "Trend-Only Mode",          group=GRP_FILTERS)

// ── Support / Resistance Breakout ────────────────────────────────────────────
var string GRP_SR = "Support / Resistance"
i_sr_lookback   = input.int(20,  "S/R Lookback Bars", minval=5, maxval=200, group=GRP_SR)

// ── Multi-Timeframe ───────────────────────────────────────────────────────────
var string GRP_MTF = "Multi-Timeframe (HTF)"
i_use_mtf       = input.bool(false, "Enable HTF Confirmation",  group=GRP_MTF)
i_htf           = input.timeframe("60", "Higher Timeframe",     group=GRP_MTF)

// ── Risk Management ───────────────────────────────────────────────────────────
var string GRP_RISK = "Risk Management"
i_sl_mode       = input.string("ATR", "SL Mode", options=["ATR","Fixed","Percent"], group=GRP_RISK)
i_atr_len       = input.int(14,   "ATR Length",                 minval=1,   group=GRP_RISK)
i_atr_sl_mult   = input.float(1.5,"ATR SL Multiplier",          minval=0.1, step=0.1, group=GRP_RISK)
i_fixed_sl_pts  = input.float(50, "Fixed SL (points/pips)",     minval=0.1, group=GRP_RISK)
i_pct_sl        = input.float(1.0,"Percent SL (%)",             minval=0.01, step=0.1, group=GRP_RISK)
i_rr_ratio      = input.float(2.0,"Risk/Reward Ratio",          minval=0.1, step=0.1, group=GRP_RISK)
i_use_trail     = input.bool(false,"Use Trailing Stop",         group=GRP_RISK)
i_trail_pts     = input.float(30, "Trail Offset (points)",      minval=0.1, group=GRP_RISK)
i_use_be        = input.bool(false,"Use Break-Even Stop",       group=GRP_RISK)
i_be_trigger_r  = input.float(1.0,"Break-Even Trigger (R)",     minval=0.1, step=0.1, group=GRP_RISK)
i_partial_tp    = input.bool(false,"Partial Take Profit",       group=GRP_RISK)
i_partial_pct   = input.float(50, "Partial TP %",               minval=1, maxval=99, group=GRP_RISK)
i_partial_r     = input.float(1.0,"Partial TP at (R)",          minval=0.1, step=0.1, group=GRP_RISK)

// ── Position Sizing ───────────────────────────────────────────────────────────
var string GRP_SIZE = "Position Sizing"
i_size_mode     = input.string("RiskPct","Sizing Mode", options=["FixedLot","RiskPct"], group=GRP_SIZE)
i_fixed_lot     = input.float(1.0, "Fixed Lot Size",   minval=0.001, step=0.001, group=GRP_SIZE)
i_risk_pct      = input.float(1.0, "Risk % per Trade", minval=0.01,  step=0.1,   group=GRP_SIZE)
i_leverage      = input.float(1.0, "Leverage",         minval=1,     step=1,     group=GRP_SIZE)

// ── Drawdown / Loss Protection ────────────────────────────────────────────────
var string GRP_DD = "Loss Protection"
i_max_daily_dd  = input.float(5.0,"Max Daily Drawdown (%)",     minval=0.1, step=0.1, group=GRP_DD)
i_max_consec    = input.int(3,    "Max Consecutive Losses",     minval=1,   group=GRP_DD)
i_cooldown_bars = input.int(5,    "Cooldown Bars After Loss",   minval=0,   group=GRP_DD)

// ── Session Filter ────────────────────────────────────────────────────────────
var string GRP_SESSION = "Session Filter"
i_use_session   = input.bool(false, "Enable Session Filter", group=GRP_SESSION)
i_session       = input.session("0800-1700", "Allowed Session (Exchange TZ)", group=GRP_SESSION)

// ── Backtesting Date Range ─────────────────────────────────────────────────────
var string GRP_DATE = "Date Range"
i_date_start    = input.time(timestamp("2022-01-01 00:00"), "Start Date", group=GRP_DATE)
i_date_end      = input.time(timestamp("2099-12-31 23:59"), "End Date",   group=GRP_DATE)

// ── Visuals ───────────────────────────────────────────────────────────────────
var string GRP_VIS = "Visualization"
i_show_table    = input.bool(true,  "Show Performance Table",   group=GRP_VIS)
i_color_candles = input.bool(true,  "Color Candles by Trend",   group=GRP_VIS)
i_show_sl_tp    = input.bool(true,  "Show SL / TP Lines",       group=GRP_VIS)

// =============================================================================
// ─── INDICATOR CALCULATIONS ───────────────────────────────────────────────────
// =============================================================================

// EMAs
ema_fast = ta.ema(close, i_ema_fast)
ema_slow = ta.ema(close, i_ema_slow)

// RSI
rsi = ta.rsi(close, i_rsi_len)

// ATR
atr = ta.atr(i_atr_len)

// VWAP (session-based, built-in)
vwap_val = ta.vwap(hlc3)

// Volume filter
vol_avg  = ta.sma(volume, 20)
vol_ok   = volume > vol_avg * i_vol_mult

// ADX (manual calc — no built-in adx() in v5 for strategy)
adx_len  = 14
adx_smooth = 14
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_smooth)

// Support / Resistance levels (rolling high/low)
res_level = ta.highest(high, i_sr_lookback)[1]   // [1] prevents repainting
sup_level = ta.lowest(low,   i_sr_lookback)[1]

// Multi-timeframe EMA trend
htf_ema_fast = request.security(syminfo.tickerid, i_htf, ta.ema(close, i_ema_fast), lookahead=barmerge.lookahead_off)
htf_ema_slow = request.security(syminfo.tickerid, i_htf, ta.ema(close, i_ema_slow), lookahead=barmerge.lookahead_off)
htf_bull     = htf_ema_fast > htf_ema_slow
htf_bear     = htf_ema_fast < htf_ema_slow

// =============================================================================
// ─── HELPER FUNCTIONS ─────────────────────────────────────────────────────────
// =============================================================================

// Calculate stop-loss distance in price units
f_sl_dist(is_long) =>
    float dist = switch i_sl_mode
        "ATR"     => atr * i_atr_sl_mult
        "Fixed"   => i_fixed_sl_pts * syminfo.mintick
        "Percent" => close * (i_pct_sl / 100)
        => atr * i_atr_sl_mult
    dist

// Calculate position size based on sizing mode
f_position_size(sl_dist) =>
    float qty = switch i_size_mode
        "RiskPct"  =>
            risk_usd = strategy.equity * (i_risk_pct / 100) * i_leverage
            // qty in contracts: risk_usd / (sl_dist * syminfo.pointvalue)
            risk_usd / (sl_dist * syminfo.pointvalue)
        "FixedLot" => i_fixed_lot
        => i_fixed_lot
    math.max(qty, syminfo.mintick)

// Session gate
f_in_session() =>
    not i_use_session or time(timeframe.period, i_session) != 0

// Date range gate
f_in_date_range() =>
    time >= i_date_start and time <= i_date_end

// =============================================================================
// ─── LOSS PROTECTION STATE ────────────────────────────────────────────────────
// =============================================================================

var int  consec_losses      = 0
var int  cooldown_counter   = 0
var float daily_start_eq   = strategy.equity
var float daily_dd_used    = 0.0
var bool  trade_blocked     = false

// Reset daily drawdown tracker at new day
is_new_day = dayofweek != dayofweek[1]
if is_new_day
    daily_start_eq := strategy.equity
    daily_dd_used  := 0.0

// Track consecutive losses and cooldown
if strategy.closedtrades > strategy.closedtrades[1]
    last_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if last_pnl < 0
        consec_losses    := consec_losses + 1
        cooldown_counter := i_cooldown_bars
    else
        consec_losses    := 0

if cooldown_counter > 0
    cooldown_counter := cooldown_counter - 1

// Daily drawdown check
daily_dd_used := (daily_start_eq - strategy.equity) / daily_start_eq * 100
daily_dd_ok   = daily_dd_used < i_max_daily_dd

// Gate: block new entries if protection triggers
trade_blocked := (consec_losses >= i_max_consec) or (not daily_dd_ok) or (cooldown_counter > 0)

// =============================================================================
// ─── SIGNAL LOGIC ─────────────────────────────────────────────────────────────
// =============================================================================

// Core trend
bull_trend = ema_fast > ema_slow
bear_trend = ema_fast < ema_slow

// RSI conditions
rsi_long  = rsi > i_rsi_long_min
rsi_short = rsi < i_rsi_short_max

// VWAP filter
vwap_long  = not i_use_vwap or close > vwap_val
vwap_short = not i_use_vwap or close < vwap_val

// Volume filter
vol_filter = not i_use_volume or vol_ok

// ADX filter (trending market)
adx_filter = not i_use_adx or adx_val > i_adx_thresh

// S/R Breakout (close breaks beyond previous swing high/low)
breakout_long  = close > res_level
breakout_short = close < sup_level

// HTF confirmation
htf_long_ok  = not i_use_mtf or htf_bull
htf_short_ok = not i_use_mtf or htf_bear

// Trend-only mode: skip if candle is against slow EMA slope
ema_slope_bull = ema_slow > ema_slow[3]
ema_slope_bear = ema_slow < ema_slow[3]
trend_mode_long  = not i_trend_only or ema_slope_bull
trend_mode_short = not i_trend_only or ema_slope_bear

// =============================================================================
// ─── ENTRY CONDITIONS ─────────────────────────────────────────────────────────
// =============================================================================

long_cond = bull_trend
     and rsi_long
     and breakout_long
     and vwap_long
     and vol_filter
     and adx_filter
     and htf_long_ok
     and trend_mode_long
     and f_in_session()
     and f_in_date_range()
     and not trade_blocked
     and strategy.position_size == 0   // no pyramiding

short_cond = bear_trend
     and rsi_short
     and breakout_short
     and vwap_short
     and vol_filter
     and adx_filter
     and htf_short_ok
     and trend_mode_short
     and f_in_session()
     and f_in_date_range()
     and not trade_blocked
     and strategy.position_size == 0

// =============================================================================
// ─── TRADE EXECUTION ─────────────────────────────────────────────────────────
// =============================================================================

var float entry_price  = na
var float sl_price     = na
var float tp_price     = na
var float partial_done = 0.0   // tracks if partial TP fired this trade

// ── Long Entry ────────────────────────────────────────────────────────────────
if long_cond
    sl_dist   = f_sl_dist(true)
    qty       = f_position_size(sl_dist)
    entry_price := close
    sl_price    := entry_price - sl_dist
    tp_price    := entry_price + sl_dist * i_rr_ratio
    partial_done := 0.0

    strategy.entry("Long", strategy.long, qty=qty)

    if i_use_trail
        strategy.exit("Long Exit", "Long",
             trail_price  = entry_price,
             trail_offset = i_trail_pts * syminfo.mintick,
             stop         = sl_price)
    else
        strategy.exit("Long Exit", "Long",
             stop   = sl_price,
             limit  = tp_price)

// ── Short Entry ───────────────────────────────────────────────────────────────
if short_cond
    sl_dist   = f_sl_dist(false)
    qty       = f_position_size(sl_dist)
    entry_price := close
    sl_price    := entry_price + sl_dist
    tp_price    := entry_price - sl_dist * i_rr_ratio
    partial_done := 0.0

    strategy.entry("Short", strategy.short, qty=qty)

    if i_use_trail
        strategy.exit("Short Exit", "Short",
             trail_price  = entry_price,
             trail_offset = i_trail_pts * syminfo.mintick,
             stop         = sl_price)
    else
        strategy.exit("Short Exit", "Short",
             stop   = sl_price,
             limit  = tp_price)

// ── Partial Take Profit ───────────────────────────────────────────────────────
// Fire a reduce-only order at partial_r * R when enabled
if i_partial_tp and strategy.position_size != 0 and partial_done == 0.0
    if strategy.position_size > 0
        partial_price = entry_price + (tp_price - entry_price) * (i_partial_r / i_rr_ratio)
        if high >= partial_price
            strategy.order("Partial TP Long", strategy.short,
                 qty    = math.abs(strategy.position_size) * (i_partial_pct / 100),
                 limit  = partial_price)
            partial_done := 1.0
    else if strategy.position_size < 0
        partial_price = entry_price - (entry_price - tp_price) * (i_partial_r / i_rr_ratio)
        if low <= partial_price
            strategy.order("Partial TP Short", strategy.long,
                 qty   = math.abs(strategy.position_size) * (i_partial_pct / 100),
                 limit = partial_price)
            partial_done := 1.0

// ── Break-Even Stop ───────────────────────────────────────────────────────────
// Move SL to entry once price moves i_be_trigger_r * risk in our favour
if i_use_be and strategy.position_size != 0
    if strategy.position_size > 0
        be_trigger = entry_price + math.abs(entry_price - sl_price) * i_be_trigger_r
        if high >= be_trigger and sl_price < entry_price
            sl_price := entry_price
            strategy.exit("Long Exit", "Long", stop=sl_price, limit=tp_price)
    else if strategy.position_size < 0
        be_trigger = entry_price - math.abs(sl_price - entry_price) * i_be_trigger_r
        if low <= be_trigger and sl_price > entry_price
            sl_price := entry_price
            strategy.exit("Short Exit", "Short", stop=sl_price, limit=tp_price)

// Clear levels when flat
if strategy.position_size == 0
    entry_price := na
    sl_price    := na
    tp_price    := na
    partial_done := 0.0

// =============================================================================
// ─── VISUALIZATION ────────────────────────────────────────────────────────────
// =============================================================================

// EMA plots
plot(ema_fast, "EMA Fast", color=color.new(color.blue, 0),  linewidth=2)
plot(ema_slow, "EMA Slow", color=color.new(color.orange, 0), linewidth=2)

// VWAP
plot(i_use_vwap ? vwap_val : na, "VWAP", color=color.new(color.purple, 30), linewidth=1)

// Support / Resistance levels
plot(res_level, "Resistance", color=color.new(color.red,   60), style=plot.style_stepline, linewidth=1)
plot(sup_level, "Support",    color=color.new(color.green, 60), style=plot.style_stepline, linewidth=1)

// SL / TP levels for active position
plot(i_show_sl_tp ? sl_price : na, "Stop Loss",    color=color.new(color.red,   0), style=plot.style_linebr, linewidth=1)
plot(i_show_sl_tp ? tp_price : na, "Take Profit",  color=color.new(color.green, 0), style=plot.style_linebr, linewidth=1)
plot(i_show_sl_tp ? entry_price : na, "Entry",     color=color.new(color.white, 0), style=plot.style_linebr, linewidth=1)

// Candle coloring
candle_color = i_color_candles
     ? (bull_trend ? color.new(color.teal, 70) : color.new(color.maroon, 70))
     : na
barcolor(candle_color)

// Buy / Sell arrows
plotshape(long_cond,  title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.lime,  size=size.small, text="BUY")
plotshape(short_cond, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, text="SELL")

// Active trade info label (updates each bar)
if strategy.position_size != 0
    pos_dir   = strategy.position_size > 0 ? "LONG" : "SHORT"
    pos_pnl   = strategy.openprofit
    lbl_color = pos_pnl >= 0 ? color.new(color.green, 20) : color.new(color.red, 20)
    label.new(bar_index, high,
         text  = pos_dir + "\nPnL: " + str.tostring(math.round(pos_pnl, 2)),
         color = lbl_color,
         style = label.style_label_down,
         textcolor = color.white,
         size  = size.tiny)

// =============================================================================
// ─── PERFORMANCE DASHBOARD TABLE ──────────────────────────────────────────────
// =============================================================================

// Helpers for table metrics
f_win_rate() =>
    wins = 0
    for i = 0 to strategy.closedtrades - 1
        if strategy.closedtrades.profit(i) > 0
            wins += 1
    strategy.closedtrades > 0 ? wins / strategy.closedtrades * 100 : 0.0

f_profit_factor() =>
    gross_profit = 0.0
    gross_loss   = 0.0
    for i = 0 to strategy.closedtrades - 1
        p = strategy.closedtrades.profit(i)
        if p > 0
            gross_profit += p
        else
            gross_loss   += math.abs(p)
    gross_loss > 0 ? gross_profit / gross_loss : 0.0

f_avg_rr() =>
    total_rr = 0.0
    count    = 0
    for i = 0 to strategy.closedtrades - 1
        entry_p = strategy.closedtrades.entry_price(i)
        exit_p  = strategy.closedtrades.exit_price(i)
        dir     = strategy.closedtrades.size(i) > 0 ? 1 : -1
        pnl_pts = (exit_p - entry_p) * dir
        if pnl_pts != 0
            total_rr += pnl_pts
            count    += 1
    count > 0 ? total_rr / count : 0.0

var table perf_table = table.new(position.top_right, 2, 8,
     border_width=1,
     border_color=color.new(color.gray, 50),
     bgcolor=color.new(color.black, 20))

if i_show_table and barstate.islast
    win_rate_val    = f_win_rate()
    pf_val          = f_profit_factor()
    net_profit_val  = strategy.netprofit
    max_dd_val      = strategy.max_drawdown
    avg_rr_val      = f_avg_rr()
    total_trades    = strategy.closedtrades

    header_bg    = color.new(color.navy, 0)
    label_bg     = color.new(color.black, 40)
    value_good   = color.new(color.lime, 20)
    value_bad    = color.new(color.red,  20)
    value_neut   = color.new(color.gray, 20)
    txt_col      = color.white

    // Header
    table.cell(perf_table, 0, 0, "METRIC",      text_color=txt_col, bgcolor=header_bg, text_size=size.small)
    table.cell(perf_table, 1, 0, "VALUE",        text_color=txt_col, bgcolor=header_bg, text_size=size.small)

    table.cell(perf_table, 0, 1, "Total Trades", text_color=txt_col, bgcolor=label_bg,  text_size=size.small)
    table.cell(perf_table, 1, 1, str.tostring(total_trades), text_color=txt_col, bgcolor=value_neut, text_size=size.small)

    table.cell(perf_table, 0, 2, "Win Rate",     text_color=txt_col, bgcolor=label_bg,  text_size=size.small)
    table.cell(perf_table, 1, 2, str.tostring(math.round(win_rate_val, 1)) + "%",
         text_color=txt_col, bgcolor=(win_rate_val >= 50 ? value_good : value_bad), text_size=size.small)

    table.cell(perf_table, 0, 3, "Profit Factor", text_color=txt_col, bgcolor=label_bg, text_size=size.small)
    table.cell(perf_table, 1, 3, str.tostring(math.round(pf_val, 2)),
         text_color=txt_col, bgcolor=(pf_val >= 1.5 ? value_good : (pf_val >= 1 ? value_neut : value_bad)), text_size=size.small)

    table.cell(perf_table, 0, 4, "Net Profit",   text_color=txt_col, bgcolor=label_bg,  text_size=size.small)
    table.cell(perf_table, 1, 4, "$" + str.tostring(math.round(net_profit_val, 2)),
         text_color=txt_col, bgcolor=(net_profit_val >= 0 ? value_good : value_bad), text_size=size.small)

    table.cell(perf_table, 0, 5, "Max Drawdown", text_color=txt_col, bgcolor=label_bg,  text_size=size.small)
    table.cell(perf_table, 1, 5, "$" + str.tostring(math.round(max_dd_val, 2)),
         text_color=txt_col, bgcolor=value_bad, text_size=size.small)

    table.cell(perf_table, 0, 6, "Avg RR (pts)", text_color=txt_col, bgcolor=label_bg,  text_size=size.small)
    table.cell(perf_table, 1, 6, str.tostring(math.round(avg_rr_val, 4)),
         text_color=txt_col, bgcolor=value_neut, text_size=size.small)

    table.cell(perf_table, 0, 7, "Consec Loss",  text_color=txt_col, bgcolor=label_bg,  text_size=size.small)
    table.cell(perf_table, 1, 7, str.tostring(consec_losses),
         text_color=txt_col, bgcolor=(consec_losses >= i_max_consec ? value_bad : value_neut), text_size=size.small)

// =============================================================================
// ─── ALERT CONDITIONS ─────────────────────────────────────────────────────────
// =============================================================================

alertcondition(long_cond,  title="BUY Signal",  message="UBF: BUY signal on {{ticker}} at {{close}}")
alertcondition(short_cond, title="SELL Signal", message="UBF: SELL signal on {{ticker}} at {{close}}")

// TP / SL hit approximations (position closed positively/negatively)
long_closed  = strategy.position_size[1] > 0 and strategy.position_size == 0
short_closed = strategy.position_size[1] < 0 and strategy.position_size == 0
last_pnl_    = strategy.closedtrades > 0 ? strategy.closedtrades.profit(strategy.closedtrades - 1) : 0.0

alertcondition(long_closed  and last_pnl_ > 0, title="Long TP Hit",  message="UBF: LONG TP hit on {{ticker}}")
alertcondition(long_closed  and last_pnl_ < 0, title="Long SL Hit",  message="UBF: LONG SL hit on {{ticker}}")
alertcondition(short_closed and last_pnl_ > 0, title="Short TP Hit", message="UBF: SHORT TP hit on {{ticker}}")
alertcondition(short_closed and last_pnl_ < 0, title="Short SL Hit", message="UBF: SHORT SL hit on {{ticker}}")

// ─── NEWS FILTER PLACEHOLDER ──────────────────────────────────────────────────
// To integrate a news filter, replace `news_filter_ok` with your external signal.
// Example: connect via webhook or manual input group toggle before high-impact events.
news_filter_ok = true   // always true until wired up — set to false to block trades

// =============================================================================
// END OF SCRIPT
// =============================================================================
